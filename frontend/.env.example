# Frontend environment configuration for TalentForge

# === PRODUCTION (Vercel) ===
# Set this to your deployed backend URL
VITE_API_URL=https://your-backend-url

# === LOCAL DEVELOPMENT ===
# Leave empty for dev server (uses relative URLs / proxies to localhost:5002)
# VITE_API_URL=

# === MOBILE TESTING (Local Network) ===
# To test on a real phone/tablet on the same network:
# 1. Find your PC's local IP: 
#    Windows (PowerShell): ipconfig | findstr "IPv4"
#    Linux/Mac: ifconfig | grep inet
# 2. Set VITE_API_URL to http://<YOUR_PC_IP>:5002
#    Example: VITE_API_URL=http://192.168.1.100:5002
# 3. Ensure Flask backend is running with: python flask_server/app.py
# 4. Access frontend from mobile: http://<YOUR_PC_IP>:5173